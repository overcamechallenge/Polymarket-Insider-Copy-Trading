# ==============================================================================
# 15-MINUTE UP/DOWN COPY — npm run fifteen-min:copy
# ==============================================================================
# Real-time WebSocket copy trading via Polymarket RTDS (activity trades).
# Filters to 15m up/down markets and copies watched wallets as they trade.
#
# FIFTEEN_MIN_WATCH_LIST supports wallets, @usernames, polymarket.com/@user URLs.
# If unset, falls back to WHALE_WATCH_LIST.

FIFTEEN_MIN_WATCH_LIST=''
FIFTEEN_MIN_DRY_RUN=true
# FIFTEEN_MIN_PAPER_TRADING=true
# FIFTEEN_MIN_PAPER_START_USD=500
FIFTEEN_MIN_MIN_TRADE_USD=5
FIFTEEN_MIN_MIN_BUY_PRICE=0.15
FIFTEEN_MIN_MAX_BUY_PRICE=0.95

# Dedicated sizing for 15m bot (does NOT use COPY_* / MAX_* below unless unset)
FIFTEEN_MIN_COPY_STRATEGY=PERCENTAGE
FIFTEEN_MIN_COPY_SIZE=5.0
FIFTEEN_MIN_MAX_ORDER_SIZE_USD=25.0
FIFTEEN_MIN_MIN_ORDER_SIZE_USD=1.0
FIFTEEN_MIN_MAX_POSITION_SIZE_USD=50.0
# FIFTEEN_MIN_MAX_DAILY_VOLUME_USD=200.0
# FIFTEEN_MIN_TRADE_MULTIPLIER=1.0
# FIFTEEN_MIN_TIERED_MULTIPLIERS='1-50:1.5,50-200:1.0,200+:0.5'
# Adaptive-only:
# FIFTEEN_MIN_ADAPTIVE_MIN_PERCENT=3
# FIFTEEN_MIN_ADAPTIVE_MAX_PERCENT=10
# FIFTEEN_MIN_ADAPTIVE_THRESHOLD_USD=300

# Optional override (default matches 5m + 15m updown, e.g. btc-updown-5m-…):
# FIFTEEN_MIN_SLUG_REGEX='updown-(?:5|15)m|up-or-down-(?:5|15)m'
# FIFTEEN_MIN_WS_URL='wss://ws-live-data.polymarket.com'
# FIFTEEN_MIN_WS_STALE_MS=45000

# ==============================================================================
# WHALE POSITION SYNC — npm run whale-positions:watch
# ==============================================================================
# Checks whale active positions on a schedule (default every 4h).
# First run: saves baseline snapshot — NO trades.
# Later runs: if positions changed vs last snapshot → copy the difference.
#
# WHALE_WATCH_LIST supports wallet addresses, @usernames, and polymarket.com/@username URLs.

WHALE_WATCH_LIST=''
# Hours between checks; fractions allowed (0.1 = 6 min, 0.5 = 30 min). Minimum 1 minute.
WHALE_POSITION_CHECK_INTERVAL_HOURS=1
WHALE_POSITION_DRY_RUN=true
WHALE_POSITION_MIN_DELTA_USD=25
WHALE_POSITION_MIN_DELTA_PCT=0.02
WHALE_POSITION_MIN_VALUE_USD=10
WHALE_POSITION_MIN_BUY_PRICE=0.20
WHALE_POSITION_MAX_BUY_PRICE=0.90

# Mirror the whale's existing positions on the very first check instead of only
# saving a baseline. Default false (first run = baseline only, no trades).
# WHALE_POSITION_COPY_ON_FIRST_RUN=false

# Paper trading mode (virtual portfolio, no real orders)
# WHALE_POSITION_PAPER_TRADING=true
# WHALE_POSITION_PAPER_START_USD=500

# ==============================================================================
# LIVE TRADING (only when WHALE_POSITION_DRY_RUN=false and not paper mode)
# ==============================================================================
# PROXY_WALLET='0xYourWalletAddress'
# PRIVATE_KEY='your_private_key_without_0x_prefix'
# CLOB_HTTP_URL='https://clob.polymarket.com/'
# RPC_URL='https://polygon-rpc.com'
# USDC_CONTRACT_ADDRESS='0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174'

# ==============================================================================
# COPY STRATEGY
# ==============================================================================
COPY_STRATEGY=PERCENTAGE
COPY_SIZE=10.0
MAX_ORDER_SIZE_USD=100.0
MIN_ORDER_SIZE_USD=1.0
# Max USD exposure per market/outcome token (omit or set 0 to disable)
MAX_POSITION_SIZE_USD=100.0

# ==============================================================================
# FOLLOW-WALLET SCANNER — npm run find-follow-wallets
# ==============================================================================
# Optional tuning (defaults shown):
# FOLLOW_MIN_TRADE_USD=1000
# FOLLOW_MAX_ENTRY_PRICE=0.5
# FOLLOW_JOIN_DAYS=0          # 0 = no join-date filter; set e.g. 14 to require accounts joined within N days
# FOLLOW_MARKET_END_DAYS=30
# FOLLOW_SWEEP_MARKETS=200
# FOLLOW_TOP_N=30

# ==============================================================================
# SOCKS5 PROXY (recommended for live trading)
# ==============================================================================
# Routes all HTTP(S) traffic through a SOCKS proxy — Polymarket APIs, CLOB orders,
# watchlist resolution, and follow-wallet scans. Required if your network blocks
# direct Polymarket access.
#
# Recommended format (socks5h proxies DNS too):
#   SOCKS_PROXY_URL='socks5h://username:password@host:port'
#
# Local Tor example:
#   SOCKS_PROXY_URL='socks5h://127.0.0.1:9050'
#
# SOCKS_PROXY_URL='socks5h://username:password@host:port'

# ==============================================================================
# OPTIONAL
# ==============================================================================
# REQUEST_TIMEOUT_MS=10000
# NETWORK_RETRY_LIMIT=3
# RETRY_LIMIT=3
# CLOB_SDK_SILENCE_ERRORS=true
# SLACK_WEBHOOK_URL='https://hooks.slack.com/services/...'
